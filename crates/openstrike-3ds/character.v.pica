.constf constants(1.0, 0.003921568627, 0.000030517578125, 0.0)
.fvec projection[4]
.fvec weights
.in inuv v0
.in inclr v1
.in inpos0 v2
.in inpos1 v3
.out outpos position
.out outclr color
.out outuv texcoord0
.entry main
.proc main
    mul r0.xyz, weights.xxx, inpos0
    mul r1.xyz, weights.yyy, inpos1
    add r0.xyz, r0, r1
    mov r0.w, constants.x
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul outclr, constants.yyyy, inclr
    mov outuv, inuv
    end
.end
